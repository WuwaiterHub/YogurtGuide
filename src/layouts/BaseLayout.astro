---
import SocialIcons from '../components/SocialIcons.astro';

interface Props {
	title?: string;
	description?: string;
}

const { title, description = '以專業製程角度紀錄優格種類、菌種、製法與批次實驗。' } = Astro.props;
const pageTitle = title ? `${title} · YogurtGuide` : 'YogurtGuide';
const { pathname } = Astro.url;
const base = import.meta.env.BASE_URL;
const officialOrigin = 'https://yogurtguide.wuwaiter.com';
const officialPath = (() => {
	const prefix = '/YogurtGuide';
	let path = pathname.startsWith(prefix) ? pathname.slice(prefix.length) : pathname;
	if (!path.startsWith('/')) path = `/${path}`;
	if (!path.endsWith('/')) path += '/';
	return path;
})();
const canonical = new URL(officialPath, officialOrigin).href;
const isStrainsPage = pathname.includes('/cultures/species');
const isYogurtTypesPage = pathname.includes('/cultures') && !isStrainsPage;
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="YogurtGuide" />
		<meta property="og:locale" content="zh_Hant" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={`${officialOrigin}/brand/field-note-yogurt.png`} />
		<title>{pageTitle}</title>
		<link rel="stylesheet" href={`${base}fonts/fonts.css`} />
	</head>
	<body>
		<header class="site-header">
			<div class="site-header__inner">
				<a class="brand" href={base}>
					<span class="brand__word">Yogurt</span><span class="brand__guide">Guide</span>
				</a>
				<nav class="nav" aria-label="主要導覽">
					<a href={`${base}batches/`} aria-current={pathname.includes('/batches') ? 'page' : undefined}
						>批次實驗</a
					>
					<a href={`${base}cultures/`} aria-current={isYogurtTypesPage ? 'page' : undefined}
						>優格種類</a
					>
					<a href={`${base}powders/`} aria-current={pathname.includes('/powders') ? 'page' : undefined}
						>菌粉</a
					>
					<a href={`${base}cultures/species/`} aria-current={isStrainsPage ? 'page' : undefined}
						>菌種與菌株</a
					>
					<a href={`${base}pairing/`} aria-current={pathname.includes('/pairing') ? 'page' : undefined}
						>搭配</a
					>
					<a href={`${base}market/`} aria-current={pathname.includes('/market') ? 'page' : undefined}
						>市售優格</a
					>
					<a href={`${base}methods/`} aria-current={pathname.includes('/methods') ? 'page' : undefined}
						>製法</a
					>
					<a href={`${base}glossary/`} aria-current={pathname.includes('/glossary') ? 'page' : undefined}
						>詞彙</a
					>
					<a href={`${base}about/`} aria-current={pathname.includes('/about') ? 'page' : undefined}>關於</a>
				</nav>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<div class="site-footer__inner">
				<div class="site-footer__copy">
					<p class="site-footer__note">中文記述 · 專業術語附英文</p>
					<p class="site-footer__brand">YogurtGuide — Yogurt Process Notes</p>
					<p class="site-footer__note"><a href={`${base}privacy/`}>隱私權</a></p>
				</div>
				<SocialIcons variant="qr" class="site-footer__social" />
			</div>
		</footer>
	</body>
</html>

<style is:global>
	@import '../styles/global.css';
</style>
