---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const recipeEntries = (await getCollection('overnightOats', ({ data }) => !data.draft)).sort((a, b) =>
	a.data.title.localeCompare(b.data.title, 'zh-Hant'),
);
const recipes = await Promise.all(
	recipeEntries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

function refId(ref: { id: string } | string | undefined) {
	if (!ref) return undefined;
	return typeof ref === 'string' ? ref : ref.id;
}

function totalGrams(ingredients: { amount: number; unit: 'g' | 'ml' }[]) {
	if (!ingredients.every((item) => item.unit === 'g')) return null;
	return ingredients.reduce((sum, item) => sum + item.amount, 0);
}

const singles = [
	{
		group: '',
		items: [
			{
				name: '燕麥',
				en: 'Oats',
				slug: 'oats',
				body: '含 β-葡聚醣，有助改善膽固醇、穩定餐後血糖與增加飽足。效益取決於是否選全穀、用它取代主食澱粉、以及是否熱煮。Granola 與燕麥奶不能直接當成吃燕麥。',
			},
			{
				name: '奇亞籽',
				en: 'Chia Seeds',
				body: '含膳食纖維，吸水後會膨脹並讓優格變稠；先從少量加入。',
			},
			{
				name: '亞麻籽粉',
				en: 'Ground Flaxseed',
				body: '含油脂與膳食纖維，拌入後會略為增稠；建議使用熟粉。',
			},
			{
				name: '洋車前子殼',
				en: 'Psyllium husk',
				body: '車前子外殼，水溶性纖維高，吸水後成膠、讓優格明顯變稠。先從 1/2–1 小匙拌入，隨即再喝足夠的水；粉要充分化開，避免結塊成膠坨。選未調味殼粉，不要用加糖的沖泡纖維飲。一次加太多容易脹、噎或腹瀉。',
			},
		],
	},
];

const combos = [
	{
		group: '高蛋白',
		items: [
			{
				name: '高蛋白慕斯',
				body: '無糖希臘優格＋巧克力或抹茶乳清蛋白 1 匙＋少量鮮乳或水拌勻。稠度夠時接近冰淇淋/慕斯。運動後補蛋白好用。',
			},
			{
				name: '花生醬優格',
				body: '希臘優格＋無糖花生醬 1–2 匙＋蜂蜜或楓糖少許拌勻。蛋白質與油脂都高，可再撒可可碎粒。常見早餐碗做法。',
			},
			{
				name: '鷹嘴豆水煮蛋碗',
				body: '希臘優格舖底＋瀝乾鷹嘴豆＋水煮蛋（或切絲）＋橄欖油少許。地中海優格碗常見的蛋白質組合，不含水果。',
			},
		],
	},
	{
		group: '高纖維',
		items: [
			{
				name: '高纖亞麻籽',
				body: '一般無糖優格＋熟亞麻籽粉 1 匙＋熟黑芝麻粒。粉會吸水、質地略濃，補油脂與纖維。',
			},
		],
	},
	{
		group: '鹹口味組',
		items: [
			{
				name: '地中海鹹香',
				body: '希臘優格＋特級初榨橄欖油 1 匙＋研磨黑胡椒＋少許海鹽（可加義式香草）。稠度接近奶油乳酪，可單吃或當蔬菜沾醬。',
			},
			{
				name: '芝麻醬 Za’atar',
				body: '希臘優格＋純芝麻醬（tahini）1 匙＋橄欖油＋Za’atar 少許。中東/地中海優格碗常見鹹香組合，可再加烤鷹嘴豆增加咬感。',
			},
			{
				name: '檸檬蒜香',
				body: '希臘優格＋少許檸檬汁＋蒜泥或蒜末＋鹽。當沾醬或鹹碗底；酸香會把優格本身的酸拉得更清爽。',
			},
		],
	},
	{
		group: '純粹好吃',
		items: [
			{
				name: '濃郁黑芝麻',
				body: '希臘優格＋無糖黑芝麻粉 1–2 匙＋蜂蜜 1 匙。能包住芝麻粉，攪成芝麻糊般濃稠。',
			},
			{
				name: '抹茶拿鐵風',
				body: '一般無糖優格＋無糖純抹茶粉 1 小匙＋楓糖漿或蜂蜜 1 匙。流動性高較好拌勻；微酸配抹茶苦甜。',
			},
			{
				name: '堅果肉桂香',
				body: '一般無糖優格＋無調味綜合堅果＋純肉桂粉少許＋楓糖漿。肉桂融進液體，堅果補嚼勁。',
			},
			{
				name: '巧克力花生',
				body: '希臘優格＋無糖花生醬＋純可可粉少許（先用一點優格化開再拌）。可撒可可碎粒；像巧克力花生醬甜點、不必加水果。',
			},
		],
	},
];

const additives = (await getCollection('additives', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.sortOrder - b.data.sortOrder || a.data.title.localeCompare(b.data.title, 'zh-Hant'),
);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="搭配" description="隔夜燕麥優格食譜：每項食材都有重量。另有原型食材、益生元與其他吃法。">
	<section class="section">
		<div class="wrap">
			<h1 class="page-title">搭配<span class="en-sub">Pairing</span></h1>
			<p class="page-lead">隔夜燕麥優格是主體。每項食材都寫克數或毫升。</p>

			<section class="record-block" id="overnight-oats">
				<h2 class="record-block__title">1. 隔夜燕麥優格<span class="en-sub">Overnight oats</span></h2>
				{
					recipes.map(({ entry, Content }) => {
						const data = entry.data;
						const grams = totalGrams(data.ingredients);
						return (
							<article class="pairing-group">
								<h3 class="pairing-group__title">
									{data.title}
									<span class="en-sub">
										{data.servings} 人份 · 冷藏 {data.soakHours} 小時
									</span>
								</h3>
								<p class="meta">{data.texture}</p>
								<table class="meta-table">
									<thead>
										<tr>
											<th>食材</th>
											<th>重量</th>
											<th>×2</th>
										</tr>
									</thead>
									<tbody>
										{data.ingredients.map((item) => {
											const foodId = refId(item.foodRef);
											return (
												<tr>
													<td>
														{foodId ? (
															<a href={`${base}pairing/foods/${foodId}/`}>{item.name}</a>
														) : (
															item.name
														)}
														{item.note ? <span class="meta"> {item.note}</span> : null}
													</td>
													<td>
														{item.amount} {item.unit}
													</td>
													<td>
														{item.amount * 2} {item.unit}
													</td>
												</tr>
											);
										})}
										{grams !== null && (
											<tr>
												<th>合計</th>
												<td>{grams} g</td>
												<td>{grams * 2} g</td>
											</tr>
										)}
									</tbody>
								</table>
								<ol>
									{data.steps.map((step) => (
										<li>{step}</li>
									))}
								</ol>
								<div class="prose">
									<Content />
								</div>
							</article>
						);
					})
				}
			</section>

			<section class="record-block" id="singles">
				<h2 class="record-block__title">2. 食材說明<span class="en-sub">Whole foods</span></h2>
				{
					singles.map((group) => (
						<div class="pairing-group">
							{group.group ? <h3 class="pairing-group__title">{group.group}</h3> : null}
							<ul class="list">
								{group.items.map((item) =>
									item.slug ? (
										<li>
											<a class="list-item pairing-item" href={`${base}pairing/foods/${item.slug}/`}>
												<h4 class="pairing-item__title glossary-term">
													{item.name}
													<span class="glossary-term__en">{item.en}</span>
												</h4>
												<p class="pairing-item__body">{item.body}</p>
											</a>
										</li>
									) : (
										<li class="list-item pairing-item" style="cursor: default;">
											<h4 class="pairing-item__title glossary-term">
												{item.name}
												<span class="glossary-term__en">{item.en}</span>
											</h4>
											<p class="pairing-item__body">{item.body}</p>
										</li>
									),
								)}
							</ul>
						</div>
					))
				}
			</section>

			<section class="record-block" id="prebiotics">
				<h2 class="record-block__title">3. 益生元<span class="en-sub">Prebiotics</span></h2>
				<div class="pairing-group">
					<ul class="list">
						{
							additives.map(({ id, data }) => (
								<li>
									<a class="list-item pairing-item" href={`${base}pairing/additives/${id}/`}>
										<h4 class="pairing-item__title glossary-term">
											{data.title}
											<span class="glossary-term__en">{data.titleEn}</span>
										</h4>
										<p class="pairing-item__body">{data.summary}</p>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<section class="record-block" id="combos">
				<h2 class="record-block__title">4. 其他吃法<span class="en-sub">Other combinations</span></h2>
				{
					combos.map((group) => (
						<div class="pairing-group">
							<h3 class="pairing-group__title">{group.group}</h3>
							<ul class="list">
								{group.items.map((item) => (
									<li class="list-item pairing-item" style="cursor: default;">
										<h4 class="pairing-item__title">{item.name}</h4>
										<p class="pairing-item__body">{item.body}</p>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</section>
		</div>
	</section>
</BaseLayout>
