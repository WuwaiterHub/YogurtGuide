---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('glossary', ({ data }) => !data.draft)).sort((a, b) =>
	a.data.termZh.localeCompare(b.data.termZh, 'zh-Hant'),
);
const terms = await Promise.all(
	entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const categoryLabel: Record<string, string> = {
	process: '製程（process）',
	microbiology: '微生物（microbiology）',
	quality: '品質（quality）',
	equipment: '器材（equipment）',
	general: '一般（general）',
};
---

<BaseLayout title="專有名詞" description="優格製程專有名詞中英對照表。">
	<section class="section">
		<div class="wrap">
			<h1 class="page-title">專有名詞<span class="en-sub">Glossary</span></h1>
			<p class="page-lead">中文為主，專業用語附英文，方便閱讀與對照文獻。</p>
			<ul class="list">
				{
					terms.map(({ entry, Content }) => (
						<li class="list-item" style="cursor: default;">
							<h3 class="glossary-term">
								{entry.data.termZh}
								<span class="glossary-term__en">{entry.data.termEn}</span>
							</h3>
							<p class="meta">{categoryLabel[entry.data.category] ?? entry.data.category}</p>
							<div class="prose"><Content /></div>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>
