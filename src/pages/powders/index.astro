---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const powders = (await getCollection('starterPowders', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.sortOrder - b.data.sortOrder,
);

const brands: { slug: string; name: string }[] = [];
const byBrand = new Map<string, typeof powders>();
for (const item of powders) {
	const { brandSlug, brand } = item.data;
	if (!byBrand.has(brandSlug)) {
		brands.push({ slug: brandSlug, name: brand });
		byBrand.set(brandSlug, []);
	}
	byBrand.get(brandSlug)?.push(item);
}

// 少於 3 款的品牌併成「其它」，放在最後。
const minPerBrand = 3;
const otherItems = brands
	.filter((brand) => (byBrand.get(brand.slug)?.length ?? 0) < minPerBrand)
	.flatMap((brand) => byBrand.get(brand.slug) ?? []);
const groups = [
	...brands
		.filter((brand) => (byBrand.get(brand.slug)?.length ?? 0) >= minPerBrand)
		.map((brand) => ({ ...brand, items: byBrand.get(brand.slug) ?? [] })),
	...(otherItems.length > 0 ? [{ slug: 'other', name: '其它', items: otherItems }] : []),
];

const brandNote: Record<string, string> = {
	jarou: '優格菌四款。',
	bhk: '這裡只收發酵用的手作優格粉。',
	bubu: '這次只列鮮奶優格菌粉。',
	chuanxiu: '同一菌的不同包數併成一列。',
	yobite: '500、200 這類數字是活菌數。',
	angel: '百鑽是安琪的消費品牌。',
	baisheng: '納豆菌粉不是優格菌，列在最後。',
	probio: '普羅家族的優格菌粉，需用優格機。',
	leezen: '里仁自有品牌，可常溫發酵。',
	mesim: '菌種來自美國，台灣分裝。',
	vilson: '克菲爾型，含酵母，常溫發酵。',
	other: '少於 3 款的品牌併在這裡。',
};

function packUnit(unit: string) {
	if (!unit) return '';
	if (/標價|規格|彙整|像|混雜|未|條數/.test(unit)) return '';
	if (!/包|盒|瓶|袋/.test(unit)) return '';
	return unit;
}

function money(data: (typeof powders)[number]['data']) {
	if (!data.priceAmount || !data.priceCurrency) return '沒有價格資訊';
	const symbol = data.priceCurrency === 'TWD' ? 'NT$' : 'CN¥';
	const unit = packUnit(data.priceUnit);
	const amount = unit ? `${symbol}${data.priceAmount}／${unit}` : `${symbol}${data.priceAmount}`;
	return `${amount} · ${data.priceAsOf}`;
}

function strainLine(strains: { name: string; code?: string }[]) {
	if (strains.length === 0) return '沒有菌種資訊';
	return strains.map((strain) => (strain.code ? `${strain.name} ${strain.code}` : strain.name)).join(', ');
}

function packImages(data: (typeof powders)[number]['data']) {
	const first = data.packImage ? [{ src: data.packImage, caption: data.packCaption }] : [];
	return [...first, ...data.packImages];
}

function specLines(data: (typeof powders)[number]['data']) {
	return [
		['包裝', data.packSize],
		['內容物', data.contents],
		['發酵溫度', data.temperature],
		['發酵時間', data.fermentTime],
	].filter((line): line is [string, string] => Boolean(line[1]));
}

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="菌粉" description="家酪優、BHK、布布優格、川秀、優比特、安琪百鑽、佰生優、普羅拜爾、里仁、喜又美、米森的發酵菌粉：菌種、包裝、標價與評價。">
	<section class="section">
		<div class="wrap">
			<h1 class="page-title">菌粉<span class="en-sub">Starter Powders</span></h1>
			<p class="page-lead">十一個品牌、這次搜得到的發酵菌粉。價格只寫金額、幣別、單位和日期。</p>
			<ul class="powder-jump">
				{
					groups.map((group) => (
						<li>
							<a href={`#${group.slug}`}>
								{group.name}（{group.items.length}）
							</a>
						</li>
					))
				}
			</ul>

			{
				groups.map((group) => (
					<section class="record-block" id={group.slug}>
						<h2 class="record-block__title">{group.name}</h2>
						<p class="meta">{brandNote[group.slug]}</p>
						{
							group.items.map(({ id, data }) => (
								<article class="market-card" id={id}>
									<h3 class="market-card__title">
										{data.brand} {data.productName}
									</h3>
									{group.slug === 'other' && brandNote[data.brandSlug] && (
										<p class="meta">{brandNote[data.brandSlug]}</p>
									)}
									<div class="powder-shots">
										{packImages(data).length === 0 ? (
											<figure class="powder-shot powder-shot--empty">
												<p>本輪未取得包裝圖</p>
											</figure>
										) : (
											<figure class="powder-shot" data-carousel>
												<div class:list={['powder-book', { 'powder-book--flip': packImages(data).length > 1 }]}>
													{packImages(data).map((image, index) => (
														<div class="powder-page" data-caption={image.caption ?? '包裝'}>
															<img
																src={`${base}${image.src}`}
																alt={`${data.brand} ${data.productName} 包裝 ${index + 1}`}
																loading={index === 0 ? 'lazy' : 'eager'}
															/>
														</div>
													))}
												</div>
												<figcaption class="powder-book__caption">
													<span class="powder-book__label">{packImages(data)[0].caption ?? '包裝'}</span>
													{packImages(data).length > 1 && (
														<span class="powder-count">1 / {packImages(data).length}</span>
													)}
												</figcaption>
												{packImages(data).length > 1 && (
													<>
														<button class="powder-nav powder-nav--prev" type="button" data-step="-1" aria-label="上一張">
															‹
														</button>
														<button class="powder-nav powder-nav--next" type="button" data-step="1" aria-label="下一張">
															›
														</button>
													</>
												)}
											</figure>
										)}
										{specLines(data).length > 0 && (
											<figure class="powder-shot">
												<ul class="powder-spec-list">
													{specLines(data).map(([label, value]) => (
														<li>
															{label}：{value}
														</li>
													))}
												</ul>
											</figure>
										)}
									</div>
									<table class="meta-table">
										<tbody>
											<tr>
												<th>菌種</th>
												<td>{strainLine(data.strains)}</td>
											</tr>
											<tr>
												<th>價格</th>
												<td>{money(data)}</td>
											</tr>
											<tr>
												<th>評價</th>
												<td>{data.reviewTier === 'none' ? '沒有評價資訊' : data.review}</td>
											</tr>
										</tbody>
									</table>
								</article>
							))
						}
					</section>
				))
			}
		</div>
	</section>
</BaseLayout>

<script>
	// 多張包裝圖用 StPageFlip 做翻書效果：紙張會捲曲、帶陰影，也能用手指從右下角拖著翻。
	// 網站與 Android App（WebView）共用；系統設定「減少動態效果」時直接換頁、不播動畫。
	import { PageFlip } from 'page-flip';

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	for (const carousel of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
		const book = carousel.querySelector<HTMLElement>('.powder-book--flip');
		if (!book) continue;
		const pages = [...book.querySelectorAll<HTMLElement>('.powder-page')];
		const caption = carousel.querySelector('.powder-book__label');
		const count = carousel.querySelector('.powder-count');

		// 頁面大小和圖片框一樣（3:4，高 11rem）。
		const height = Math.round(parseFloat(getComputedStyle(document.documentElement).fontSize) * 11);
		const flipbook = new PageFlip(book, {
			width: Math.round((height * 3) / 4),
			height,
			size: 'fixed',
			// 不讓套件把外框撐成雙頁寬，維持單頁（直式）顯示。
			autoSize: false,
			usePortrait: true,
			showCover: false,
			flippingTime: 1400,
			maxShadowOpacity: 0.7,
			mobileScrollSupport: true,
		});
		flipbook.loadFromHTML(pages);

		// 單頁模式往後翻時，套件會複製目前這頁當「翻起來的紙」。把複本標成紙背，CSS 讓它只透出淡淡的反向印刷。
		new MutationObserver((records) => {
			for (const record of records) {
				for (const node of record.addedNodes) {
					if (node instanceof HTMLElement && node.classList.contains('powder-page') && !pages.includes(node)) {
						node.classList.add('powder-page--back');
					}
				}
			}
		}).observe(book.querySelector('.stf__block') ?? book, { childList: true, subtree: true });

		flipbook.on('flip', (event: { data: number }) => {
			const index = event.data;
			if (caption) caption.textContent = pages[index].dataset.caption ?? '包裝';
			if (count) count.textContent = `${index + 1} / ${pages.length}`;
		});

		for (const button of carousel.querySelectorAll<HTMLButtonElement>('.powder-nav')) {
			button.addEventListener('click', () => {
				const step = Number(button.dataset.step);
				const current = flipbook.getCurrentPageIndex();
				const target = (current + step + pages.length) % pages.length;
				if (reduceMotion.matches) flipbook.turnToPage(target);
				// 從右下角翻，像用手捏著書角往上翻。
				else if (step > 0 && target > current) flipbook.flipNext('bottom');
				else if (step < 0 && target < current) flipbook.flipPrev('bottom');
				else flipbook.flip(target, 'bottom');
				// turnToPage 不會觸發 flip 事件，自己更新。
				if (reduceMotion.matches) {
					if (caption) caption.textContent = pages[target].dataset.caption ?? '包裝';
					if (count) count.textContent = `${target + 1} / ${pages.length}`;
				}
			});
		}
	}
</script>
